APP_IMAGE=registry.example.com/team/sqlite-app:release
APP_DOMAIN=app.example.com
APP_PORT=3000
SQLITE_BACKUP_IMAGE=registry.example.com/team/sqlite-backup:release
SQLITE_DATABASE=app.db
SQLITE_UID=1000
SQLITE_GID=1000
LITESTREAM_BUCKET=example-backups
LITESTREAM_PREFIX=web/production/app.db
LITESTREAM_REGION=us-east-1
LITESTREAM_ENDPOINT=
LITESTREAM_RETENTION=168h
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
